
{
  "manifest_version": 2,
  "module_id": "org.3mm.terminal",
  "name": "3mm Terminal",
  "version": "1.0.0",
  "description": "Interactive Linux terminal extension for local and authorized remote sessions.",
  "runtimes": [
    "core",
    "ui"
  ],
  "entrypoints": {
    "core": "application-extension.json",
    "ui": "compiled-ui.json"
  },
  "compatibility": {
    "protocol": "1.0",
    "core": ">=0.1.0",
    "agent": ">=0.1.0",
    "architectures": [
      "any"
    ]
  },
  "capabilities": {
    "provides": [],
    "consumes": []
  },
  "permissions": [
    "data.read",
    "data.write",
    "process.spawn"
  ],
  "dependencies": {},
  "conflicts": [],
  "configuration_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "idle_timeout_seconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 3600
      }
    }
  },
  "configuration_defaults": {
    "idle_timeout_seconds": 900
  },
  "registrations": [],
  "health_check": {
    "type": "json_file",
    "path": "application-extension.json"
  }
}
